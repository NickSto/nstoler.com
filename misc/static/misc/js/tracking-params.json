{
  "global": [
    {
      "section": "Google Analytics / Google Ads",
      "source": "https://support.google.com/analytics/answer/10917952",
      "note": "Not all are from the source url.",
      "params": [
        "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "utm_id", "utm_name",
        "utm_source_platform", "utm_creative_format", "utm_marketing_tactic", "utm_kxconfid",
        "gclid", "_ga", "_gl"
      ]
    },
    {
      "section": "Email marketing platforms",
      "note": "From Claude, I believe.",
      "params": [
        "mkt_tok", "vero_id", "vero_conv", "_hsenc", "_hsmi", "__hssc", "__hstc", "__hsfp"
      ]
    },
    {
      "section": "Misc analytics",
      "params": [
        "oly_anon_id", "oly_enc_id", "epik", "guccounter", "guce_referrer", "guce_referrer_sig",
        "pk_campaign", "pk_kwd", "pk_source", "pk_medium", "pk_content", "s_cid", "scid"
      ]
    },
    {
      "section": "Unknown origin",
      "note": "Don't know what sites created these.",
      "params": [
        "link_id", "can_id", "email_referrer", "email_subject", "user_email", "user_email_md5",
        "referrer", "ref", "source", "taid", "link_source",
        "tw_source", "tw_adid", "tw_campaign", "tw_kwdid", "embed_host_url"
      ]
    },
    {
      "section": "Twitter",
      "source": "https://business.twitter.com/en/help/campaign-measurement-and-analytics/conversion-tracking-for-websites.html",
      "params": ["twclid"]
    },
    {
      "section": "Facebook",
      "source": "https://developers.facebook.com/docs/marketing-api/conversions-api/parameters/fbp-and-fbc#what-is-meta-s-clickid",
      "params": ["fbclid"]
    },
    {
      "section": "TikTok",
      "source": "https://ads.tiktok.com/help/article/tiktok-click-id",
      "params": ["ttclid"]
    },
    {
      "section": "Yahoo",
      "source": "https://ads-help.yahoo-net.jp/s/article/H000044650",
      "params": ["yclid"]
    },
    {
      "section": "Yandex",
      "source": "https://yandex.com/support/metrica/data/yclid.html",
      "params": ["yclid"]
    },
    {
      "section": "Microsoft Advertising",
      "source": "https://help.ads.microsoft.com/apex/index/3/en/60000",
      "params": ["msclkid"]
    },
    {
      "section": "Google DoubleClick",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["gclsrc", "dclid"]
    },
    {
      "section": "Google Merchant Centre",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["gPromoCode", "gQT"]
    },
    {
      "section": "Google AdWords",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["gbraid", "wbraid", "gad_source"]
    },
    {
      "section": "Google Ads",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["gad_campaignid"]
    },
    {
      "section": "Google Analytics",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["utm_klaviyo_id"]
    },
    {
      "section": "Google Shopping/Organic",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["srsltid"]
    },
    {
      "section": "Mailchimp",
      "source": "https://github.com/mpchadwick/tracking-query-params-registry/",
      "params": ["mc_cid", "mc_eid"]
    }
